# Copy to .env. Never commit .env.

# --- Postgres (docker-compose reads these too) ---
# Pick your own password. It must match the two URLs below; compose initialises the
# database with whatever is here on first run. The container binds to 127.0.0.1 only.
POSTGRES_USER=enola
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_DB=enola
POSTGRES_HOST_PORT=5433

# --- API / worker ---
# Both must carry the POSTGRES_USER / POSTGRES_PASSWORD set above.
ENOLA_DATABASE_URL=postgresql+psycopg://enola:choose-a-local-password@127.0.0.1:5433/enola
ENOLA_TEST_DATABASE_URL=postgresql+psycopg://enola:choose-a-local-password@127.0.0.1:5433/enola_test
ENOLA_API_HOST=127.0.0.1
ENOLA_API_PORT=8000
# Comma-separated origins allowed to call the API with credentials.
ENOLA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Session cookies are only sent over HTTPS when true. Keep false for local dev.
ENOLA_COOKIE_SECURE=false
ENOLA_SESSION_TTL_HOURS=720
# Skip the login screen for loopback and private-range (LAN) clients only. Keep false
# the moment Enola is hosted anywhere reachable from the internet.
ENOLA_AUTOLOGIN=false
# Owner login. Generate a hash with:  python -m enola.core.auth hash "your password"
# Write every `$` in the hash as `$$`: docker compose interpolates this file, and Enola
# turns `$$` back into `$` when it reads the value.
ENOLA_OWNER_NAME=Your name
ENOLA_OWNER_EMAIL=you@example.com
ENOLA_OWNER_PASSWORD_HASH=
ENOLA_TIMEZONE=Asia/Karachi
ENOLA_LOG_LEVEL=INFO
ENOLA_LOG_JSON=false

# --- Agent ---
# Which provider runs the agent: "google" (Gemini, free tier) or "anthropic".
# The Gemini free tier lets Google use prompts and responses to improve its products;
# the paid tier and Anthropic do not.
ENOLA_MODEL_PROVIDER=google
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Model roles. Leave all three blank for the provider's defaults (Gemini:
# 2.5-flash for chat, 2.5-flash-lite for utility). ENOLA_DEFAULT_MODEL covers both
# roles; ENOLA_AGENT_MODEL / ENOLA_UTILITY_MODEL override one.
ENOLA_DEFAULT_MODEL=
ENOLA_AGENT_MODEL=
ENOLA_UTILITY_MODEL=
# Embeddings for semantic retrieval. "voyage" needs VOYAGE_API_KEY; "hash" is a
# deterministic local stand-in that keeps the app and tests working without a key.
ENOLA_EMBEDDER=hash
VOYAGE_API_KEY=
ENOLA_EMBEDDING_DIM=1024

# --- Job discovery (in progress, not working reliably yet) ---
# Remotive, RemoteOK and Arbeitnow need no key and run as soon as the worker does.
# JSearch (RapidAPI, free tier) is the only free route to onsite Karachi listings;
# without this key that one source stays dormant and says so in the log.
JSEARCH_API_KEY=
# Comma-separated. Scored against a posting's title, summary and tags.
ENOLA_JOB_SKILLS=

# --- Email (IMAP read-only; sending is SMTP and always goes to Held) ---
# Gmail with a Google app password, never your account password. Leave the user empty
# to disable mail entirely. The password falls back to ENOLA_SMTP_PASSWORD below, since
# it is the same account and the same app password.
ENOLA_IMAP_HOST=imap.gmail.com
ENOLA_IMAP_PORT=993
ENOLA_IMAP_USER=
ENOLA_IMAP_PASSWORD=

# --- Files ---
ENOLA_STORAGE_ROOT=./var/files

# --- Worker / notifications ---
ENOLA_DAILY_BRIEF_HOUR=7
# Email-to-self channel. Leave SMTP host empty to disable delivery (rows still queue).
ENOLA_SMTP_HOST=
ENOLA_SMTP_PORT=587
ENOLA_SMTP_USER=
ENOLA_SMTP_PASSWORD=
ENOLA_SMTP_FROM=

# --- Web (Vite reads VITE_* only) ---
# Leave empty: the dev server proxies /api to ENOLA_API_HOST:ENOLA_API_PORT, so the app
# is same-origin and the session cookie works on localhost and 127.0.0.1 alike.
# Set it only when the web app is hosted separately from the API.
VITE_API_BASE_URL=
# Minimum time the boot splash stays up, in milliseconds. Click skips it.
VITE_SPLASH_MIN_MS=3000
