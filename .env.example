# Copy to .env. Never commit .env.

# --- Postgres (docker-compose reads these too) ---
POSTGRES_USER=enola
POSTGRES_PASSWORD=enola
POSTGRES_DB=enola
POSTGRES_HOST_PORT=5433

# --- API / worker ---
ENOLA_DATABASE_URL=postgresql+psycopg://enola:enola@127.0.0.1:5433/enola
ENOLA_TEST_DATABASE_URL=postgresql+psycopg://enola:enola@127.0.0.1:5433/enola_test
ENOLA_API_HOST=127.0.0.1
ENOLA_API_PORT=8000
# Comma-separated origins allowed to call the API with credentials.
ENOLA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Session cookies are only sent over HTTPS when true. Keep false for local dev.
ENOLA_COOKIE_SECURE=false
ENOLA_SESSION_TTL_HOURS=720
# Owner login. Generate a hash with:  python -m enola.core.auth hash "your password"
ENOLA_OWNER_NAME=Faizan
ENOLA_OWNER_EMAIL=you@example.com
ENOLA_OWNER_PASSWORD_HASH=
ENOLA_TIMEZONE=Asia/Karachi
ENOLA_LOG_LEVEL=INFO
ENOLA_LOG_JSON=false

# --- Agent ---
ANTHROPIC_API_KEY=
ENOLA_AGENT_MODEL=claude-opus-5
# Embeddings for semantic retrieval. "voyage" needs VOYAGE_API_KEY; "hash" is a
# deterministic local stand-in that keeps the app and tests working without a key.
ENOLA_EMBEDDER=hash
VOYAGE_API_KEY=
ENOLA_EMBEDDING_DIM=1024

# --- Files ---
ENOLA_STORAGE_ROOT=./var/files

# --- Worker / notifications ---
ENOLA_DAILY_BRIEF_HOUR=7
# Email-to-self channel. Leave SMTP host empty to disable delivery (rows still queue).
ENOLA_SMTP_HOST=
ENOLA_SMTP_PORT=587
ENOLA_SMTP_USER=
ENOLA_SMTP_PASSWORD=
ENOLA_SMTP_FROM=

# --- Web (Vite reads VITE_* only) ---
# Leave empty: the dev server proxies /api to ENOLA_API_HOST:ENOLA_API_PORT, so the app
# is same-origin and the session cookie works on localhost and 127.0.0.1 alike.
# Set it only when the web app is hosted separately from the API.
VITE_API_BASE_URL=
